<%- include('partials/head', { title: 'Upload' }) %>
<%- include('partials/header') %>

  <main class="wrap form-page">
    <h1>Upload to the library</h1>
    <% if (error) { %>
      <p class="alert"><%= error %></p>
    <% } %>
    <form method="POST" action="/upload" enctype="multipart/form-data" class="stacked-form">
      <label>
        Title
        <input type="text" name="title" value="<%= form.title || '' %>" required />
      </label>
      <label>
        Author / Creator
        <input type="text" name="authorOrCreator" value="<%= form.authorOrCreator || '' %>" />
      </label>
      <label>
        Description
        <textarea name="description" rows="4"><%= form.description || '' %></textarea>
      </label>
      <label>
        Type
        <select name="mediaType" required>
          <option value="">Choose one</option>
          <option value="book" <%= form.mediaType === 'book' ? 'selected' : '' %>>Book</option>
          <option value="video" <%= form.mediaType === 'video' ? 'selected' : '' %>>Video</option>
        </select>
      </label>
      <label>
        Category
        <select name="category" required>
          <option value="">Choose one</option>
          <% categories.forEach(function(c) { %>
            <option value="<%= c %>" <%= form.category === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </label>
      <label>
        File (PDF, EPUB, MOBI, TXT, MP4, WebM, MOV, MKV — up to 2GB)
        <input type="file" name="file" required />
      </label>
      <label class="checkbox-row">
        <input type="checkbox" name="rightsConfirmed" required />
        I confirm I own this content or otherwise have the right to share it, and it does not infringe on anyone else's copyright.
      </label>
      <button type="submit" class="cta cta--large">Upload</button>
    </form>
  </main>

<%- include('partials/footer') %>

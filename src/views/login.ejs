<%- include('partials/head', { title: 'Log in' }) %>
<%- include('partials/header') %>

  <main class="wrap form-page form-page--narrow">
    <h1>Log in</h1>
    <% if (error) { %>
      <p class="alert"><%= error %></p>
    <% } %>
    <form method="POST" action="/login" class="stacked-form">
      <label>
        Email
        <input type="email" name="email" value="<%= email %>" required autofocus />
      </label>
      <label>
        Password
        <input type="password" name="password" required />
      </label>
      <button type="submit" class="cta cta--large">Log in</button>
    </form>
    <p class="form-footnote">No account yet? <a href="/register">Join the community</a></p>
  </main>

<%- include('partials/footer') %>

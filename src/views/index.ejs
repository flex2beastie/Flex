<%- include('partials/head', { title: 'Browse' }) %>
<%- include('partials/header') %>

  <section class="hero">
    <div class="wrap">
      <p class="hero__eyebrow">QUESTION EVERYTHING. THINK CRITICALLY.</p>
      <h1 class="hero__title">WE NEED <span class="accent">YOU!</span></h1>
      <p class="hero__sub">A community library of books and videos on conspiracy, government transparency, free energy, and the stories the mainstream narrative leaves out.</p>
    </div>
  </section>

  <main class="wrap">
    <form class="filters" method="GET" action="/">
      <input
        type="search"
        name="q"
        placeholder="Search titles, authors, descriptions..."
        value="<%= filters.q %>"
        class="filters__search"
      />
      <select name="type">
        <option value="">All types</option>
        <option value="book" <%= filters.mediaType === 'book' ? 'selected' : '' %>>Books</option>
        <option value="video" <%= filters.mediaType === 'video' ? 'selected' : '' %>>Videos</option>
      </select>
      <select name="category">
        <option value="">All categories</option>
        <% categories.forEach(function(c) { %>
          <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
      <select name="sort">
        <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest</option>
        <option value="popular" <%= filters.sort === 'popular' ? 'selected' : '' %>>Most downloaded</option>
        <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest</option>
      </select>
      <button type="submit" class="cta">Filter</button>
    </form>

    <% if (items.length === 0) { %>
      <p class="empty-state">Nothing here yet. <a href="/upload">Be the first to upload.</a></p>
    <% } else { %>
      <div class="grid">
        <% items.forEach(function(item) { %>
          <a href="/media/<%= item.id %>" class="card">
            <span class="card__type card__type--<%= item.media_type %>"><%= item.media_type %></span>
            <h2 class="card__title"><%= item.title %></h2>
            <% if (item.author_or_creator) { %>
              <p class="card__author">by <%= item.author_or_creator %></p>
            <% } %>
            <p class="card__category"><%= item.category %></p>
            <p class="card__meta">
              <span><%= item.download_count %> download<%= item.download_count === 1 ? '' : 's' %></span>
              <span>&middot;</span>
              <span>by <%= item.uploader_name %></span>
            </p>
          </a>
        <% }) %>
      </div>
    <% } %>
  </main>

<%- include('partials/footer') %>
